rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars: usuário lê e escreve apenas a própria pasta
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Imagens de estabelecimento: leitura pública, escrita autenticada
    match /establishments/{estId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}