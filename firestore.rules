rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuários: lê/edita apenas o próprio perfil
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Estabelecimentos: leitura pública, escrita apenas do dono
    match /establishments/{estId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Serviços: leitura pública, escrita pelo dono do estabelecimento
    match /services/{svcId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reservas: cliente cria/lê as próprias; empresa lê/atualiza as do seu est.
    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
          || request.auth.uid != null);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
    }
  }
}